# Copy to .env and adjust. Never commit .env.
# Read by the backend (pydantic-settings) and by docker compose.

ENVIRONMENT=development            # development | test | production

# --- Postgres (docker compose service) ---
POSTGRES_USER=tie
POSTGRES_PASSWORD=tie_dev_password
POSTGRES_DB=tie
POSTGRES_HOST_PORT=5433            # host port; 5432 is often taken by a native Postgres
DATABASE_URL=postgresql+psycopg://tie:tie_dev_password@localhost:5433/tie
TEST_DATABASE_URL=postgresql+psycopg://tie:tie_dev_password@localhost:5433/tie_test

# --- Redis ---
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave commented out in development to use the built-in dev secret. Must be >= 32 chars;
# in production a real random value is required or the app refuses to start.
# JWT_SECRET=
# REQUIRED for `docker compose --profile app up` (the containers run in production mode).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# --- HTTP ---
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOG_JSON=false

# --- LLM ---
# Free key: https://aistudio.google.com/apikey
# NOTE: on the free tier Google may use prompts to improve its products. Only upload
# fake resumes or your own; never other people's.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=90

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- Full stack in Docker (docker compose --profile app up -d --build) ---
WEB_HOST_PORT=8090                 # open http://localhost:8090
# Password for the demo account (demo@example.com). Unset: no demo account is created.
# DEMO_PASSWORD=
RATE_LIMITS_ENABLED=true

# --- Uploads ---
UPLOAD_DIR=../data/private/uploads
MAX_RESUME_BYTES=5242880
